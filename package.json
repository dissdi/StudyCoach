{
  "name": "study-coach-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace=apps/web",
    "mobile": "npm run start --workspace=apps/mobile",
    "dev": "concurrently \"npm run web\" \"npm run mobile\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
